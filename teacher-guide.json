  "lesson_delivery": {
    "recommended_sequence": [
      {
        "stage": "Preparation",
        "teacher_actions": [
          "Review the lesson objectives.",
          "Prepare appropriate teaching and learning materials.",
          "Identify prerequisite knowledge.",
          "Prepare examples and assessment questions."
        ]
      },
      {
        "stage": "Discover",
        "teacher_actions": [
          "Introduce a familiar mathematical situation.",
          "Activate learners' prior knowledge.",
          "Encourage observation and questioning.",
          "Connect mathematics to everyday experiences."
        ]
      },
      {
        "stage": "Learn",
        "teacher_actions": [
          "Explain the mathematical concept clearly.",
          "Demonstrate worked examples.",
          "Use diagrams and practical illustrations.",
          "Check understanding throughout instruction."
        ]
      },
      {
        "stage": "Practice",
        "teacher_actions": [
          "Provide guided exercises.",
          "Allow learners to solve problems independently.",
          "Identify misconceptions.",
          "Provide additional examples where necessary."
        ]
      },
      {
        "stage": "Knowledge Check",
        "teacher_actions": [
          "Administer short assessment questions.",
          "Review learner responses.",
          "Identify learning gaps.",
          "Provide corrective explanations."
        ]
      },
      {
        "stage": "Apply",
        "teacher_actions": [
          "Present real-life mathematical problems.",
          "Encourage learners to select appropriate methods.",
          "Assess reasoning and accuracy.",
          "Encourage practical problem-solving."
        ]
      },
      {
        "stage": "Voice",
        "teacher_actions": [
          "Ask learners to explain mathematical concepts.",
          "Encourage mathematical vocabulary.",
          "Allow oral, audio or written explanations.",
          "Assess clarity of mathematical reasoning."
        ]
      },
      {
        "stage": "Journal",
        "teacher_actions": [
          "Ask learners to reflect on their learning.",
          "Review difficulties and achievements.",
          "Identify areas requiring further support."
        ]
      },
      {
        "stage": "Evidence and Mastery",
        "teacher_actions": [
          "Review assessment performance.",
          "Examine completed exercises.",
          "Verify practical learning evidence.",
          "Determine readiness for progression."
        ]
      }
    ]
  },
